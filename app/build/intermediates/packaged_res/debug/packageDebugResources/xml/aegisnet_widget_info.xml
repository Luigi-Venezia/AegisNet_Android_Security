<?xml version="1.0" encoding="utf-8"?>

<!--
    Metadata Android usa per sapere come può essere installato e aggiornato
    il widget. updatePeriodMillis chiede un aggiornamento periodico al sistema;
    dopo una Security Scan l'app forza inoltre un aggiornamento immediato.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/aegisnet_widget_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />

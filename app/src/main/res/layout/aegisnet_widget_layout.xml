<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/aegis_dark_surface">

    <TextView
        android:id="@+id/tvWidgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_title"
        android:textColor="@color/aegis_green"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetScoreLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_score_label"
        android:textColor="@color/aegis_gray"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvWidgetScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/aegis_green_light"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/aegis_white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetLastScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/aegis_gray"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnOpenAegisNet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_open_aegisnet"
        android:textSize="12sp" />

</LinearLayout>